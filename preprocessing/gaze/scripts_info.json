            "--bbox_scale_vertical": {
                "type": "real",
                "default": 1.0,
                "config": {"name": "BBox Scale Vertical", "from": 0.1, "to": 5.0, "stepSize": 0.1, "unit": ""}
            }
        },
        "title": "Map Gaze to Faces",
        "description": "Detects faces in the scene camera video and maps eye-tracking fixations to identified persons",
